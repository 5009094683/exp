# Copy to .env.local for local development. In production, set these in your
# host's dashboard (Vercel: Project Settings > Environment Variables; Cloudflare:
# Worker > Settings > Build > Variables for SITE_*, and Variables and Secrets for
# LEADS_*).
#
# Every variable is optional. Pages are prerendered, so SITE_* values are read at
# build time: change a value, then redeploy. Unset optional values hide the
# related UI instead of showing a placeholder.

# ---------------------------------------------------------------------------
# Product
# ---------------------------------------------------------------------------
SITE_PRODUCT_NAME="AgentOS"
SITE_PRODUCT_TAGLINE="Enterprise AI agent infrastructure"
# Meta description. Defaults to a sentence built from the product name.
# SITE_PRODUCT_DESCRIPTION=""

# Canonical origin of the deployed site. Used for canonical links, the sitemap,
# social previews and API examples in the docs. On Vercel this defaults to the
# project's production domain; everywhere else, set it.
# SITE_URL="https://www.example.com"

# One hex color. Hover, text and contrast shades are derived from it.
SITE_ACCENT_COLOR="#6366f1"

# ---------------------------------------------------------------------------
# Company
# ---------------------------------------------------------------------------
# Defaults to the product name.
# SITE_COMPANY_NAME="Example Labs"
# Used in the footer, legal pages and structured data. Defaults to the company name.
# SITE_COMPANY_LEGAL_NAME="Example Labs, Inc."
# Separate lines with "|".
# SITE_COMPANY_ADDRESS="100 Example Street, Suite 200 | San Francisco, CA 94105 | United States"
# SITE_COMPANY_FOUNDED="2026"
# Shown in the footer and legal pages, for example a company registration number.
# SITE_COMPANY_REGISTRATION="Company No. 00000000"

# ---------------------------------------------------------------------------
# Contact
# ---------------------------------------------------------------------------
# General inbox. Also the fallback address when a form cannot be submitted.
# SITE_CONTACT_EMAIL="hello@example.com"
# SITE_SALES_EMAIL="sales@example.com"
# SITE_SUPPORT_EMAIL="support@example.com"
# Published in /.well-known/security.txt, which points to the contact page when unset.
# SITE_SECURITY_EMAIL="security@example.com"
# Named in the privacy policy. Falls back to the general inbox.
# SITE_PRIVACY_EMAIL="privacy@example.com"
# SITE_CONTACT_PHONE="+1 415 555 0100"
# Scheduling link offered after a request is submitted.
# SITE_BOOKING_URL="https://cal.com/example/intro"

# ---------------------------------------------------------------------------
# Links
# ---------------------------------------------------------------------------
# SITE_SOCIAL_X="https://x.com/example"
# SITE_SOCIAL_LINKEDIN="https://www.linkedin.com/company/example"
# SITE_SOCIAL_GITHUB="https://github.com/example"
# SITE_SOCIAL_YOUTUBE="https://www.youtube.com/@example"
# SITE_SOCIAL_DISCORD="https://discord.gg/example"
# SITE_STATUS_URL="https://status.example.com"
# SITE_CAREERS_URL="https://jobs.example.com"

# ---------------------------------------------------------------------------
# Announcement bar (hidden when the text is unset)
# ---------------------------------------------------------------------------
# SITE_ANNOUNCEMENT_TEXT="Now onboarding early-access teams"
# SITE_ANNOUNCEMENT_HREF="/early-access"

# ---------------------------------------------------------------------------
# Legal pages
# ---------------------------------------------------------------------------
# The legal pages are templates; have a lawyer review them before launch.
# Effective date shown on the privacy, terms and cookie pages (YYYY-MM-DD).
# SITE_LEGAL_EFFECTIVE_DATE="2026-01-01"
# Governing law named in the terms.
# SITE_LEGAL_JURISDICTION="the State of Delaware, United States"

# ---------------------------------------------------------------------------
# Compliance roadmap on the security page
# Each value: planned | in-progress | achieved | hidden
# Only mark a framework "achieved" once you hold the report or certificate.
# ---------------------------------------------------------------------------
# SITE_COMPLIANCE_SOC2="planned"
# SITE_COMPLIANCE_ISO27001="planned"
# SITE_COMPLIANCE_GDPR="planned"
# SITE_COMPLIANCE_HIPAA="hidden"

# ---------------------------------------------------------------------------
# Social proof (JSON). Each section stays hidden until you provide real data.
# ---------------------------------------------------------------------------
# SITE_CUSTOMERS='["Customer One","Customer Two"]'
# SITE_TESTIMONIALS='[{"quote":"...","name":"Full Name","title":"Job title","company":"Company"}]'
# SITE_TEAM='[{"name":"Full Name","role":"Co-founder & CEO","url":"https://www.linkedin.com/in/example"}]'
# SITE_BACKERS='["Investor One","Accelerator Two"]'
# SITE_STATS='[{"value":"12","label":"design partners"}]'

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------
# Set to "true" to keep a staging deployment out of search results.
# SITE_NOINDEX="false"
# SITE_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Early-access and contact requests (runtime, server-side only)
# With no destination set, requests are only written to the host's logs.
# On Cloudflare these are runtime values, not build variables: set them under
# Worker > Settings > Variables and Secrets, and in .dev.vars for local runs.
# ---------------------------------------------------------------------------
# Slack or Discord incoming webhook, or any endpoint that accepts a JSON POST.
# LEADS_WEBHOOK_URL=""
# Email notifications through Resend (https://resend.com). All three are needed.
# RESEND_API_KEY=""
# LEADS_TO_EMAIL="founders@example.com"
# LEADS_FROM_EMAIL="Website <website@example.com>"
# Extra origins allowed to post to the forms, comma separated. The site's own
# origin is always allowed.
# LEADS_ALLOWED_ORIGINS=""
