{
  "name": "agentos-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env BUILD_TARGET=static next build",
    "start": "next start",
    "preview:cf": "wrangler dev",
    "deploy:cf": "pnpm build:static && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && wrangler types worker/worker-configuration.d.ts --check && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:e2e:server": "node scripts/e2e.mjs server",
    "test:e2e:static": "node scripts/e2e.mjs static",
    "test:e2e": "pnpm test:e2e:server && pnpm test:e2e:static",
    "check:rebrand": "node scripts/check-rebrand.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
