{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentos-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-22",
  // Keep variables and secrets added in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "assets": {
    // Produced by `pnpm build:static` (Next.js static export).
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Pages are served straight from static assets; only the API runs Worker code.
    "run_worker_first": ["/api/*"],
  },
  // Caps form submissions per visitor so the webhook and inbox cannot be flooded.
  "ratelimits": [
    {
      "name": "LEADS_RATE_LIMITER",
      // Any integer that is unique within your Cloudflare account.
      "namespace_id": "7301",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Settings for Previews, the copies of the site that `wrangler preview` creates for other
  // branches and pull requests. The block is required, and bindings are not inherited from above.
  "previews": {
    "ratelimits": [
      {
        "name": "LEADS_RATE_LIMITER",
        // A different number from production, so testing a Preview cannot use up its allowance.
        "namespace_id": "7302",
        "simple": { "limit": 30, "period": 60 },
      },
    ],
  },
}
